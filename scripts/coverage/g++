#!/usr/bin/env bash
# The g++ of scripts/coverage.sh, first on its PATH. Every compile gets coverage, and its
# notes and counts go to a directory of its own under COVERAGE_DATA, so a harness built in
# a temporary directory leaves them behind and two files of one name never share counts.
# The build's -Og stays: _FORTIFY_SOURCE=3 warns without optimisation, and -Werror makes
# that fatal.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
real=$(PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vx "$here" | paste -sd:) command -v g++)
: "${COVERAGE_DATA:?scripts/coverage.sh sets COVERAGE_DATA}"
exec "$real" --coverage -fprofile-abs-path -fprofile-update=atomic \
    -dumpdir "$(mktemp -d "$COVERAGE_DATA/XXXXXXXX")/" "$@"

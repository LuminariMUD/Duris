#!/usr/bin/env bash
# Legacy filesystem cleanup, only after the launcher's epoch-bound SQL-ready check.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd -P)"
cd "$ROOT"
if [[ $# -gt 1 || ( $# == 1 && "$1" != --check ) ]]; then
  echo "Usage: $0 [--check]" >&2
  exit 2
fi

# Validate every target before removing anything. Never follow a top-level store
# symlink; symlinks inside a store are removed as links, never traversed.
if [[ ! -d Players || -L Players || ! -r Players || ! -w Players || ! -x Players ]]; then
  echo "Unsafe or inaccessible Players/ directory; refusing filesystem wipe" >&2
  exit 1
fi
TARGETS=()
for letter in {a..z}; do TARGETS+=("Players/$letter"); done
for store in Corpses Justice SavedItems Kingdoms ShopKeepers Assocs Shapechange Tradeskills House; do
  TARGETS+=("Players/$store")
done
TARGETS+=(Ships Corpses)
check_tree() {
  local path="$1" parent
  if [[ -L "$path" || ( -e "$path" && ! -d "$path" ) ||
        "$(readlink -m -- "$path")" != "$ROOT/$path" ]]; then
    echo "Unsafe filesystem wipe target: $path" >&2
    return 1
  fi
  parent="$path"
  [[ -d "$path" ]] || parent="$(dirname "$path")"
  if [[ ! -r "$parent" || ! -w "$parent" || ! -x "$parent" ]]; then
    echo "Inaccessible filesystem wipe target: $path" >&2
    return 1
  fi
}
for path in "${TARGETS[@]}"; do check_tree "$path"; done
if [[ "${1:-}" == --check ]]; then
  echo "Filesystem wipe preflight passed; no files changed."
  exit 0
fi
for path in "${TARGETS[@]}"; do
  check_tree "$path"
  [[ -d "$path" ]] || continue
  find "$path" -mindepth 1 -maxdepth 1 ! -name .gitignore -print0 |
    while IFS= read -r -d '' entry; do rm -rf -- "$entry"; done
  echo "wipe_it_all: cleared $path"
done
mkdir -p Players/Backup Players/Corpses Players/Justice Players/SavedItems \
  Players/Kingdoms Players/ShopKeepers Players/Assocs Players/Shapechange \
  Players/Tradeskills Players/House Ships
echo "wipe_it_all: filesystem cleanup completed"

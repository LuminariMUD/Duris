#!/usr/bin/env bash
# Legacy filesystem cleanup, only after the launcher's epoch-bound SQL-ready check.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd -P)"
cd "$ROOT"
if [[ $# -gt 1 || ( $# == 1 && "$1" != --check ) ]]; then
  echo "Usage: $0 [--check]" >&2
  exit 2
fi

# Validate every target before removing anything. Never follow a top-level store
# symlink; symlinks inside a store are removed as links, never traversed.
if [[ ! -d Players || -L Players || ! -r Players || ! -w Players || ! -x Players ]]; then
  echo "Unsafe or inaccessible Players/ directory; refusing filesystem wipe" >&2
  exit 1
fi
TARGETS=()
for letter in {a..z}; do TARGETS+=("Players/$letter"); done
for store in Corpses Justice SavedItems Kingdoms ShopKeepers Assocs Shapechange Tradeskills House; do
  TARGETS+=("Players/$store")
done
TARGETS+=(Ships Corpses)
check_tree() {
  local path="$1" parent
  if [[ -L "$path" || ( -e "$path" && ! -d "$path" ) ||
        "$(readlink -m -- "$path")" != "$ROOT/$path" ]]; then
    echo "Unsafe filesystem wipe target: $path" >&2
    return 1
  fi
  parent="$path"
  [[ -d "$path" ]] || parent="$(dirname "$path")"
  if [[ ! -r "$parent" || ! -w "$parent" || ! -x "$parent" ]]; then
    echo "Inaccessible filesystem wipe target: $path" >&2
    return 1
  fi
}
for path in "${TARGETS[@]}"; do check_tree "$path"; done
check_tree Players/Backup

# Both hotboot and cold artifact boot inspect these unscoped native inputs.
# Preserve old evidence outside their live paths before the new epoch activates.
COPYOVER_PATH="${COPYOVER_STATE_FILE:-copyover.dat}"
[[ "$COPYOVER_PATH" == /* ]] || COPYOVER_PATH="$ROOT/$COPYOVER_PATH"
COPYOVER_SOURCES=("$COPYOVER_PATH" "$COPYOVER_PATH.recovering"
                  "$COPYOVER_PATH.consuming" "$COPYOVER_PATH.recovering.consuming")
COPYOVER_NAMES=(publication recovering publication.consuming recovering.consuming)
check_native_image() {
  local path="$1"
  if [[ -L "$path" || ! -f "$path" || ! -r "$path" || "$(head -c 4 -- "$path")" != COPY ]]; then
    echo "Unsafe or unrecognized native handoff image: $path" >&2
    return 1
  fi
}
check_copyover_state() {
  local index="$1" path="${COPYOVER_SOURCES[$1]}" parent
  if [[ -L "$path" || "$(readlink -m -- "$path")" != "$path" ]]; then
    echo "Unsafe native handoff path: $path" >&2
    return 1
  fi
  parent="$(dirname -- "$path")"
  if [[ ! -d "$parent" || ! -r "$parent" || ! -w "$parent" || ! -x "$parent" ]]; then
    echo "Inaccessible native handoff parent: $parent" >&2
    return 1
  fi
  [[ -e "$path" ]] || return 0
  if (( index < 2 )); then
    check_native_image "$path"
  elif [[ ! -d "$path" || ! -r "$path" || ! -w "$path" || ! -x "$path" ||
          -n "$(find "$path" -mindepth 1 -maxdepth 1 ! -name image -printf x -quit)" ]]; then
    echo "Unsafe native handoff consumption barrier: $path" >&2
    return 1
  elif [[ -e "$path/image" || -L "$path/image" ]]; then
    check_native_image "$path/image"
  fi
}
for index in "${!COPYOVER_SOURCES[@]}"; do check_copyover_state "$index"; done
# A drained scheduler may still have a durable captured retry/completion. Its
# native checkpoint is unscoped, so archive it before a new season can boot.
MAINTENANCE_PATH="${MAINTENANCE_STATE_FILE:-runtime/maintenance-scheduler.state}"
[[ "$MAINTENANCE_PATH" == /* ]] || MAINTENANCE_PATH="$ROOT/$MAINTENANCE_PATH"
MAINTENANCE_SOURCES=("$MAINTENANCE_PATH" "$MAINTENANCE_PATH.tmp")
MAINTENANCE_NAMES=(state state.tmp)
check_maintenance_state() {
  local path="$1" parent
  if [[ -L "$path" || "$(readlink -m -- "$path")" != "$path" ]]; then
    echo "Unsafe maintenance checkpoint path: $path" >&2
    return 1
  fi
  [[ -e "$path" ]] || return 0
  parent="$(dirname -- "$path")"
  if [[ ! -f "$path" || ! -r "$path" || ! -r "$parent" || ! -w "$parent" || ! -x "$parent" ]]; then
    echo "Inaccessible maintenance checkpoint: $path" >&2
    return 1
  fi
  case "$(head -c 7 -- "$path")" in
    DMSMNT[234]) ;;
    *) echo "Unrecognized maintenance checkpoint: $path" >&2; return 1 ;;
  esac
}
for path in "${MAINTENANCE_SOURCES[@]}"; do check_maintenance_state "$path"; done
if [[ "${1:-}" == --check ]]; then
  echo "Filesystem wipe preflight passed; no files changed."
  exit 0
fi
archive=""
for index in "${!COPYOVER_SOURCES[@]}"; do
  check_copyover_state "$index"
  path="${COPYOVER_SOURCES[$index]}"
  [[ -e "$path" ]] || continue
  if [[ -z "$archive" ]]; then
    check_tree Players/Backup
    mkdir -p Players/Backup
    archive="$(mktemp -d -- "$ROOT/Players/Backup/pwipe-copyover.XXXXXX")"
    printf '%s\n' "$COPYOVER_PATH" > "$archive/source-path"
  fi
  mv -T -- "$path" "$archive/${COPYOVER_NAMES[$index]}"
done
for path in "${COPYOVER_SOURCES[@]}"; do
  if [[ -e "$path" || -L "$path" ]]; then
    echo "Native handoff input remains live; refusing filesystem completion: $path" >&2
    exit 1
  fi
done
[[ -z "$archive" ]] || echo "wipe_it_all: archived native handoff evidence at $archive"
maintenance_archive=""
for index in "${!MAINTENANCE_SOURCES[@]}"; do
  path="${MAINTENANCE_SOURCES[$index]}"
  check_maintenance_state "$path"
  [[ -e "$path" ]] || continue
  if [[ -z "$maintenance_archive" ]]; then
    check_tree Players/Backup
    mkdir -p Players/Backup
    maintenance_archive="$(mktemp -d -- "$ROOT/Players/Backup/pwipe-maintenance.XXXXXX")"
    printf '%s\n' "$MAINTENANCE_PATH" > "$maintenance_archive/source-path"
  fi
  mv -T -- "$path" "$maintenance_archive/${MAINTENANCE_NAMES[$index]}"
done
for path in "${MAINTENANCE_SOURCES[@]}"; do
  if [[ -e "$path" || -L "$path" ]]; then
    echo "Maintenance checkpoint remains live; refusing filesystem completion: $path" >&2
    exit 1
  fi
done
[[ -z "$maintenance_archive" ]] || echo "wipe_it_all: archived maintenance evidence at $maintenance_archive"
for path in "${TARGETS[@]}"; do
  check_tree "$path"
  [[ -d "$path" ]] || continue
  find "$path" -mindepth 1 -maxdepth 1 ! -name .gitignore -print0 |
    while IFS= read -r -d '' entry; do rm -rf -- "$entry"; done
  echo "wipe_it_all: cleared $path"
done
mkdir -p Players/Backup Players/Corpses Players/Justice Players/SavedItems \
  Players/Kingdoms Players/ShopKeepers Players/Assocs Players/Shapechange \
  Players/Tradeskills Players/House Ships
echo "wipe_it_all: filesystem cleanup completed"

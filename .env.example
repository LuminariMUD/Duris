# Duris Environment Variables
# Copy this file to .env and modify as needed
# Load with: source .env (or use a wrapper script)

# Local/Dev or Production/Remote
ENVIRONMENT=local

# Optional versioned color profile JSON, loaded once before gameplay.
# Empty keeps the registry unconfigured. Existing output callers remain opt-in.
# See docs/guides/OUTPUT_PROFILES.md and docs/examples/output-profiles-v1.json.
DURIS_OUTPUT_PROFILES_FILE=

# game domain
GAME_DOMAIN=duris.sbs

# listen address
LISTEN_ADDRESS=127.0.0.1
# Optional development plain-telnet port used by --dev/--minimal; defaults to
# 4000 and must not be the production port.
DURIS_DEV_PORT=4000
# Optional production-role plain-telnet port used by --production; defaults to
# 7777. Set it only when a second production-role install shares a host.
DURIS_PRODUCTION_PORT=
# Optional independent TLS telnet port; defaults to the plain port plus one.
DURIS_TLS_PORT=
# The WebSocket and HTTP health listener (GET /health) is for a server with a website, and
# it is off unless this is TRUE. A MUD-only server opens no such port.
DURIS_WEBSOCKET=FALSE
# Its port when it is on. Defaults to 4050 when unset.
DURIS_WEBSOCKET_PORT=4050
# URL probed by scripts/healthcheck.sh. Match the enabled HTTP health listener's
# address and port; setting this does not enable the listener.
DURIS_HEALTH_URL=http://127.0.0.1:4050/health
# Production requires this WebSocket-only listener to be loopback so a local
# TLS terminator owns the public endpoint.
DURIS_WEBSOCKET_LISTEN_ADDRESS=127.0.0.1
# Exact comma-separated browser Origin values. Required in production.
DURIS_WEBSOCKET_ALLOWED_ORIGINS=https://www.example.com
# Immediate local reverse proxy whose forwarded client address may be trusted.
DURIS_TRUSTED_PROXY_IP=127.0.0.1

# Whole-server persistence authority. Use flatfile-primary with a client-free
# build (`make -C src PERSISTENCE_BACKEND=flatfile`).
PERSISTENCE_MODE=mariadb-primary
# Required by either flat-file mode; must be an absolute owner-controlled path.
FLATFILE_STATE_DIR=/absolute/path/to/duris/runtime/flatfile-state
# Optional flatfile-primary pre-boot backup root; defaults to backups/flatfile.
FLATFILE_BACKUP_DIR=/absolute/path/to/duris/backups/flatfile

# Database Configuration (required only by database-backed modes; there are no
# credential defaults)
# Database server address; use loopback for a local database.
DB_HOST=127.0.0.1
# Database TCP port; ignored when using DB_SOCKET.
DB_PORT=3306
# Name the account for its environment (duris_local, duris_staging, duris_prod), so that a
# command or credential sent to the wrong server fails to log in.
DB_USER=
# Password for DB_USER; never commit a real password.
DB_PASSWD=
# Database schema containing the MUD's tables.
DB_NAME=
# Exact comma-separated host/database pairs permitted for this process.
DB_ALLOWED_TARGETS=127.0.0.1/duris_dev
# Non-loopback databases require DB_TLS=TRUE and a CA file.
DB_TLS=FALSE
DB_SSL_CA=
# Optional local-mode Unix socket. Leave empty for loopback TCP.
DB_SOCKET=

# Absolute, server-user-owned directory for the locker identification receipts. It is
# named for the critical-command journal it held before the persistence reset.
CRITICAL_COMMAND_JOURNAL_DIR=/absolute/path/to/duris/runtime/critical-command-journal

# Required when SQL telemetry is enabled. Create an absolute, server-user-owned
# directory with mode 0700. The worker stores bounded outage evidence here;
# corruption, conflicting ownership or exhausted quota refuses telemetry capture.
TELEMETRY_OUTAGE_LEDGER_DIR=/absolute/path/to/duris/runtime/telemetry-outages

# DurisWeb GMCP Authentication Secret (must match website)
DURISWEB_SECRET=put-secret-here
# Optional old key accepted during a zero-downtime rotation window.
DURISWEB_SECRET_PREVIOUS=
# Opt in only when the backend may receive account names, client metadata, IP
# addresses, and invisible staff presence.
DURISWEB_PRIVATE_PRESENCE=FALSE

# Redis-backed caches, presence, maintenance, immutable world recovery, and donation
# notices are enabled for the local development template. Player dirty state remains
# owned by the local revisioned save pipeline and journal, never Redis membership.
REDIS=TRUE
# Redis TCP host; leave empty when using REDIS_SOCKET.
REDIS_HOST=127.0.0.1
# Redis TCP port; leave empty when using REDIS_SOCKET.
REDIS_PORT=6379
# Optional absolute Unix-socket path. When set, REDIS_HOST and REDIS_PORT must be empty.
REDIS_SOCKET=
# Redis logical database number.
REDIS_DB=0
# Required application/environment/deployment isolation prefix.
REDIS_NAMESPACE=duris:local:default
# Local development may use this shared fallback. Production requires the distinct
# subsystem identities below; provision their ACL rules before starting the server.
REDIS_USERNAME=
# Password for the shared local-development Redis identity.
REDIS_PASSWORD=
# Redis ACL username for world recovery.
REDIS_WORLD_USERNAME=
# Password for the world-recovery Redis identity.
REDIS_WORLD_PASSWORD=
# Redis ACL username for player presence updates.
REDIS_PRESENCE_USERNAME=
# Password for the presence Redis identity.
REDIS_PRESENCE_PASSWORD=
# Redis ACL username for cached data.
REDIS_CACHE_USERNAME=
# Password for the cache Redis identity.
REDIS_CACHE_PASSWORD=
# Redis ACL username for donation notices.
REDIS_DONATION_USERNAME=
# Password for the donation Redis identity.
REDIS_DONATION_PASSWORD=
# Redis ACL username for maintenance operations.
REDIS_MAINTENANCE_USERNAME=
# Password for the maintenance Redis identity.
REDIS_MAINTENANCE_PASSWORD=
# Enable TLS for the Redis connection (TRUE/FALSE).
REDIS_TLS=FALSE
# CA certificate file used to verify the Redis server when TLS is enabled.
REDIS_CA_CERT=
# Expected Redis TLS server name for certificate verification.
REDIS_TLS_SERVER_NAME=
# Exact comma-separated host:port/database or unix:/socket/path/database targets authorized
# for destructive Redis maintenance.
REDIS_ALLOWED_TARGETS=127.0.0.1:6379/0
# World recovery is a convenience, not a safety net, and it is off unless this is TRUE.
# Characters, pets, corpses, lockers, banks and shops are saved without it. On, a crash or a
# cold restart brings the mobs, the objects on the ground, the doors and the zone ages back
# as the last capture had them, where the boot would otherwise reset every zone. One kind of
# object is not brought back: an item a character logged in with, or was granted, and then
# dropped. A copyover keeps the world by itself.
REDIS_WORLD_STATE=FALSE
# Seconds between captures, 5 to 3600. What a capture costs: for about 20 seconds the game
# thread gives it up to 2 ms every half second, and the whole world is written to Redis,
# which holds two generations while one replaces the other. That is about 45 MiB after a
# boot and 3.3 KiB more for every object on the ground: 69 MiB with 15,000. A shorter
# interval costs more of both; a longer one restores an older world.
REDIS_WORLD_STATE_INTERVAL=600
# Boot refuses a generation older than this many seconds. It is at least the interval plus
# 600, which is also its default: leave it unset and it follows the interval.
# REDIS_WORLD_STATE_MAX_AGE=1200
# Local-only placeholder. Replace it with an independent random 32-256 byte secret
# before using this configuration outside an isolated development machine.
REDIS_WORLD_STATE_SECRET=local-development-only-world-state-hmac-change-before-shared-use
# Optional old secret accepted only while rotating recovery authentication.
REDIS_WORLD_STATE_SECRET_PREVIOUS=
# Local development enables authenticated donation notices too. Replace this distinct
# placeholder before connecting any external publisher.
REDIS_DONATION_SUBSCRIBER=TRUE
# Shared secret authenticating donation notices; must match the publisher.
REDIS_DONATION_SECRET=local-development-only-donation-hmac-change-before-shared-use

# Optional durable maintenance cursor/completion file. The default is under runtime/,
# outside the bin/ tree that make clean-all removes.
MAINTENANCE_STATE_FILE=runtime/maintenance-scheduler.state

# Character creation: open the normally unavailable player races (the
# descend-only undead forms, plus half-elf, wood elf, kuo-toa, orog, harpy,
# illithid and storm giant) in the race selection menu. They appear in their
# own clearly labelled block and are picked by typing the race name.
# Intended for local testing; leave FALSE on a live server.
CREATION_ALL_RACES=FALSE

# Character creation: expose every defined player class, including classes
# normally reached through progression or disabled by creation policy. These
# choices appear in their own clearly labelled block in class menus.
CREATION_ALL_CLASSES=FALSE

# Public staging marker. TRUE adds STAGING to the blinking login banner, which
# also names CHAOS, ALL-RACES and ALL-CLASSES when those modes are enabled.
DURIS_STAGING=FALSE

# Chaos gameplay mode. Must be exactly TRUE or FALSE.
# TRUE enables automatic level 56 characters and the other chaos rules.
CHAOS_MUD=FALSE

# Chaos-mode starter equipment profile. `standard` grants the observed high-end
# set; `enhanceable` restricts equipment and class fundamentals to the items
# admitted by the boot-time enhance index.
CHAOS_EQ_PROFILE=standard

# Optional local Chaos integration harness commands. These require both
# ENVIRONMENT=local and an exact TRUE value; leave disabled outside tests.
CHAOS_TEST_COMMANDS=FALSE

# Optional durable Chaos new-character infinite-starting grants. These are active only
# when CHAOS_MUD=TRUE. The master switch disables all additions; each feature
# can also be disabled independently. Values must be exactly TRUE or FALSE.
CHAOS_STARTER_BONUSES=TRUE
CHAOS_STARTER_FRIGATE=TRUE
CHAOS_STARTER_EPIC_SKILLS=TRUE
CHAOS_STARTER_EPIC_POINTS=TRUE
CHAOS_STARTER_BANK_PLATINUM=TRUE
CHAOS_STARTER_MATERIALS=TRUE

# Optional local test account used by selected integration harnesses. Keep these
# blank unless the account already exists; never commit real credentials. Values
# in this file must remain valid shell assignment syntax because the launcher
# sources `.env` with Bash.
GAME_ACCOUNT_NAME=
# Password for the existing local integration-test account.
GAME_ACCOUNT_PASSWORD=
# Character on that account used by gameplay integration checks.
GAME_ACCOUNT_CHARACTER_NAME=

########################################################################
# MEDIA GENERATION , SEE `docs/media-gen`
########################################################################

# ElevenLabs sound effects / speech generation, please use fish.audio below
ELEVENLABS_API_KEY=

# fish.audio voice acting
FISH_AUDIO_API_KEY=
# fish.audio model selected by the media-generation scripts.
FISH_AUDIO_MODEL_ID=s2.1-pro-free

# MusicAPI.ai - Suno 3rd Party API for music generation
GEN_MUSIC_ENDPOINT=https://api.musicapi.ai/api/v1/sonic/create
# Endpoint used to retrieve a submitted music-generation task.
GET_MUSIC_ENDPOINT=https://api.musicapi.ai/api/v1/sonic/task/
# API key for the music-generation provider.
MUSIC_API_KEY=
# Music model version sent with generation requests.
MUSIC_MODEL_VERSION=sonic-v5-5


################################################################################
# AI Service Configuration
################################################################################
#
# The AI service provides intelligent NPC dialogue using either OpenAI (cloud)
# or Ollama (local). Ollama is free and runs locally, OpenAI requires an API key.
#
# QUICK START:
#   - For FREE local AI: Install Ollama, run 'ollama pull llama3.2:1b'
#   - For cloud AI: Set OPENAI_API_KEY below
#   - In-game: Use 'ai enable' to activate, 'ai' to check status
#

#-------------------------------------------------------------------------------
# General AI Settings
#-------------------------------------------------------------------------------

# Enable debug logging for AI service (0=off, 1=on)
AI_DEBUG_MODE=1

# Maximum retry attempts when API calls fail
AI_MAX_RETRIES=3

# Maximum cached AI responses
AI_MAX_CACHE_SIZE=5000

# Cache expiration time (in seconds)
AI_CACHE_EXPIRE_SECONDS=3600

# Content Filtering
AI_CONTENT_FILTER_ENABLED=false

#-------------------------------------------------------------------------------
# OpenAI Configuration (Cloud AI - Requires API Key)
#-------------------------------------------------------------------------------

# OpenAI API key (leave empty for Ollama-only mode)
OPENAI_API_KEY=

# OpenAI API Endpoint
OPENAI_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# AI Model Selection for OpenAI
AI_MODEL=gpt-5.6-luna

# Maximum Response Length for OpenAI (in tokens)
AI_MAX_TOKENS=500

# Response Creativity for OpenAI (integer 0-10, divided by 10)
AI_TEMPERATURE=3

# OpenAI Request Timeout (in milliseconds)
AI_TIMEOUT_MS=30000

#-------------------------------------------------------------------------------
# Rate Limiting (Applies to OpenAI)
#-------------------------------------------------------------------------------

# Requests per minute limit
AI_REQUESTS_PER_MINUTE=60

# Requests per hour limit
AI_REQUESTS_PER_HOUR=1000

#-------------------------------------------------------------------------------
# Ollama Configuration (Local AI - Free, No API Key Required)
#-------------------------------------------------------------------------------

# Ollama API Endpoint
OLLAMA_API_ENDPOINT=http://localhost:11434/api/generate

# Ollama Model (using existing qwen2.5:7b)
OLLAMA_MODEL=qwen2.5:7b

# Ollama Request Timeout (in milliseconds) - increased for 7B model
OLLAMA_TIMEOUT_MS=30000

# Ollama Maximum Tokens (num_predict)
OLLAMA_MAX_TOKENS=100

# Ollama Temperature (integer 0-10, divided by 10)
OLLAMA_TEMPERATURE=7

# Ollama Top-K Sampling
OLLAMA_TOP_K=40

# Ollama Top-P Sampling (integer 0-100, divided by 100)
OLLAMA_TOP_P=90

#######################################################################
# I3 Gateway Connectoin
#######################################################################

# WebSocket URL of the Intermud-3 gateway.
I3_GATEWAY_URL=wss://i3.ngrok.dev
# Authentication key for the Intermud-3 gateway.
I3_API_KEY=
# MUD name registered with the Intermud-3 gateway.
I3_MUD_NAME=

# Account password recovery mail (libcurl SMTP). Set MAIL_ENABLED=TRUE to turn it on.
# Values are bash-sourced by scripts/cycle_mud.sh and read unquoted by the server: use only shell-safe characters (no spaces, quotes, $, backticks, ;, #, !).
MAIL_ENABLED=FALSE
# SMTP server used for account-recovery messages.
MAIL_HOST=
# SMTP server port.
MAIL_PORT=587
# Enable TLS for SMTP delivery (TRUE/FALSE).
MAIL_TLS=TRUE
# SMTP authentication username.
MAIL_USERNAME=
# SMTP authentication password; replace the placeholder locally.
MAIL_PASSWORD=put-secret-here
# Sender email address for account-recovery messages.
MAIL_FROM=noreply@yourdomain.com

# Cloudflare credentials
# Cloudflare account identifier used by operator tooling.
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare API token; provide only the permissions the intended operation needs.
CLOUDFLARE_API_TOKEN=

# Local Dev to Remote Production SSH
LOCAL_DEV_TO_REMOTE_PROD_SSH=
REMOTE_PROD_USER=
REMOTE_PROD_PW=

########################################################################
# Staging operator settings
# These describe the remote staging installation for operator workflows;
# they do not replace its own .env or automatically configure a deployment.
# Keep host details, account names, paths and credentials local.
########################################################################

# SSH target or configured alias for the staging application account.
STAGING_SSH=
# Local private-key file used to connect to the staging account.
STAGING_SSH_KEY=
# Connection address of the staging host.
STAGING_HOST=
# Hostname of the machine hosting staging.
STAGING_HOSTNAME=
# Public DNS name players use to reach the staging MUD.
STAGING_MUD_DOMAIN=
# Operating-system account that owns and runs the staging MUD.
STAGING_USER=
# Password for the staging operating-system account, if needed.
STAGING_PW=
# SSH target or alias for the host administrator, separate from the MUD account.
STAGING_ADMIN_SSH=
# Operating-system username for staging host administration.
STAGING_ADMIN_USER=
# Administrator's sudo password, if needed; never commit a real password.
STAGING_ADMIN_SUDO_PW=
# Absolute path to the Duris checkout on the staging host.
STAGING_ROOT=
# Local Git remote name used to push the staging checkout.
STAGING_GIT_REMOTE=
# Plain-telnet port exposed by the staging MUD.
STAGING_MUD_PORT=
# TLS telnet port exposed by the staging MUD.
STAGING_MUD_TLS_PORT=
# User-systemd service name for the staging MUD.
STAGING_MUD_SERVICE=

# User-systemd service name for the staging MariaDB instance.
STAGING_DB_SERVICE=
# Database host as reached from the staging installation.
STAGING_DB_HOST=
# TCP port of the staging MariaDB instance.
STAGING_DB_PORT=
# Database schema used by the staging MUD.
STAGING_DB_NAME=
# Database account used by the staging MUD.
STAGING_DB_USER=
# Password for the staging database account.
STAGING_DB_PASSWD=
# Absolute MariaDB Unix-socket path on the staging host.
STAGING_DB_SOCKET=
# MariaDB configuration-file path on the staging host.
STAGING_DB_CONFIG=

# User-systemd service name for the staging Redis instance.
STAGING_REDIS_SERVICE=
# Redis host as reached from the staging installation.
STAGING_REDIS_HOST=
# TCP port of the staging Redis instance.
STAGING_REDIS_PORT=
# Application/environment namespace prefix used by staging in Redis.
STAGING_REDIS_NAMESPACE=
# Redis ACL username for staging administration.
STAGING_REDIS_ADMIN_USER=
# Password for the staging Redis administrator.
STAGING_REDIS_ADMIN_PW=

# Existing in-game account used for staging smoke tests.
STAGING_GAME_ACCOUNT_NAME=
# Password for the staging in-game test account.
STAGING_GAME_ACCOUNT_PASSWORD=
# Character on that account used for staging smoke tests.
STAGING_GAME_ACCOUNT_CHARACTER_NAME=
